{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(git --no-pager *)",
      "Bash(git status *)",
      "Bash(gh pr view *)",
      "Bash(pnpm test:integration *)",
      "Bash(git fetch *)",
      "Bash(git config user.name \"Renato Montini\")",
      "Bash(git config user.email renatohmc@gmail.com)",
      "Bash(service postgresql start)",
      "Bash(pg_isready *)",
      "Bash(psql -h localhost *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm typecheck *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm build *)",
      "PowerShell(git --no-pager *)",
      "PowerShell(git status *)",
      "PowerShell(gh pr view *)",
      "PowerShell(pnpm test:integration *)",
      "PowerShell(git fetch *)"
    ],
    "ask": [
      "Bash(pnpm db:migrate *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(pnpm db:migrate *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git rebase *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git rebase *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited.mjs"]
          }
        ]
      }
    ]
  }
}
