# Copie para .env.local e preencha. NUNCA commite .env.local.
# Variaveis com prefixo NEXT_PUBLIC_ vao para o navegador: so valores publicos.

# URL publica do site (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys). Chave publishable: sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor (jamais usar o prefixo NEXT_PUBLIC_) ---

# Chave secreta do Supabase (sb_secret_...): ignora RLS. Nunca expor ao cliente.
SUPABASE_SECRET_KEY=

# Postgres usado pelo app (Drizzle): pooler em modo TRANSACAO (porta 6543).
DATABASE_URL=

# Postgres usado so pelo drizzle-kit (migrations): pooler em modo SESSAO (porta 5432).
DATABASE_URL_MIGRATIONS=

# Chave da API do TMDB (chamada apenas no servidor)
TMDB_API_KEY=
