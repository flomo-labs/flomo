# Copie para .env.local e preencha. NUNCA commite .env.local.
# Variaveis com prefixo NEXT_PUBLIC_ vao para o navegador: so valores publicos.

# URL publica do site (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Somente servidor (jamais usar o prefixo NEXT_PUBLIC_) ---

# Chave de service role do Supabase: ignora RLS. Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Conexao Postgres usada pelo Drizzle (Project Settings > Database)
DATABASE_URL=

# Chave da API do TMDB (chamada apenas no servidor)
TMDB_API_KEY=