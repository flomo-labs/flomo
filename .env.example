# Copie para .env.local e preencha. NUNCA commite .env.local.
# Variaveis com prefixo NEXT_PUBLIC_ vao para o navegador: so valores publicos.

# URL publica do site (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys). Chave publishable: sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor (jamais usar o prefixo NEXT_PUBLIC_) ---

# Chave secreta do Supabase (sb_secret_...): ignora RLS. Nunca expor ao cliente.
SUPABASE_SECRET_KEY=

# Postgres usado pelo app (Drizzle): pooler em modo TRANSACAO (porta 6543),
# com o usuario flomo_app.<ref> (sem poder de admin; ver docs/deploy.md, A.3).
DATABASE_URL=

# Postgres usado so pelo drizzle-kit (migrations): pooler em modo SESSAO (porta 5432).
DATABASE_URL_MIGRATIONS=

# TMDB (chamado apenas no servidor). Preencha pelo menos uma das duas; se
# as duas existirem, vale o token. Token de Leitura da API (v4, comeca com
# eyJ): recomendado, vai no cabecalho e nao aparece em URL.
TMDB_READ_ACCESS_TOKEN=
# Chave da API (v3): alternativa, vai na URL como api_key.
TMDB_API_KEY=
# So para o E2E (TMDB falso em e2e/tmdb-fake/). Deixe vazia: vale a API real.
TMDB_BASE_URL=

# Postgres dos testes de integracao (pnpm test:integration): SEMPRE o flomo-dev,
# pooler em modo transacao. Nunca a URL de producao; os testes nao leem DATABASE_URL.
DATABASE_URL_TEST=

# Opcional: ref do projeto Supabase de PRODUCAO (so o ref, nao e segredo).
# Se a DATABASE_URL_TEST apontar para ele, os testes recusam rodar.
FLOMO_PROD_DB_REF=

# Sentry (erros do servidor). DSN do projeto "flomo" no Sentry. Opcional: sem
# ela o Sentry fica desligado. Nao e segredo forte, mas e so do servidor.
SENTRY_DSN=
